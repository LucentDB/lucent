cask "lucent" do
  arch arm: "aarch64", intel: "x64"

  version "__VERSION__"
  sha256 arm:   "__SHA_ARM__",
         intel: "__SHA_INTEL__"

  url "https://github.com/LucentDB/lucent/releases/download/v#{version}/Lucent_#{version}_#{arch}.dmg"
  name "Lucent"
  desc "Native PostgreSQL GUI with a safety-gated AI copilot"
  homepage "https://github.com/LucentDB/lucent"

  livecheck do
    url :homepage
    strategy :github_latest
  end

  # Homebrew itself does not run below Big Sur, so any explicit floor is
  # redundant and `brew style` (cop Homebrew/OSDependsOn) rejects one. The
  # app's own floor travels in the bundle's LSMinimumSystemVersion.
  depends_on :macos

  app "Lucent.app"

  zap trash: [
    "~/.lucent",
    "~/Library/Application Support/lucent",
    "~/Library/Caches/com.lucent.app",
    "~/Library/Caches/lucent",
    "~/Library/HTTPStorages/com.lucent.app",
    "~/Library/Preferences/com.lucent.app.plist",
    "~/Library/Saved Application State/com.lucent.app.savedState",
    "~/Library/WebKit/com.lucent.app",
  ]

  caveats <<~EOS
    Lucent ships without an Apple Developer ID, so macOS blocks the first
    launch. This is expected for an independent app, not a sign of anything
    wrong.

    To allow it once, try to open Lucent, then go to:
      System Settings -> Privacy & Security -> "Open Anyway"

    Later launches — and every `brew upgrade` — need no further action.

    Uninstalling with `brew uninstall --zap --cask lucent` removes Lucent's
    files. Passwords you saved for database connections live in your login
    Keychain (services "lucent-connection" and "lucent-ssh") and are left
    behind; remove them with Keychain Access if you want them gone.
  EOS
end
