cask "lucent" do
  arch arm: "aarch64", intel: "x64"

  version "__VERSION__"
  sha256 arm:   "__SHA_ARM__",
         intel: "__SHA_INTEL__"

  url "https://github.com/LucentDB/lucent/releases/download/v#{version}/Lucent_#{version}_#{arch}.dmg"
  name "Lucent"
  desc "Native Postgres GUI with an AI copilot"
  homepage "https://github.com/LucentDB/lucent"

  depends_on macos: ">= :big_sur"

  app "Lucent.app"

  caveats <<~EOS
    Lucent is not notarized by Apple, so macOS will refuse to open it the
    first time. This is expected for an independent app without a paid
    Developer ID, not a sign of anything wrong.

    To allow it once:
      System Settings -> Privacy & Security -> scroll down -> "Open Anyway"

    Every later launch, and every `brew upgrade`, works normally.
  EOS

  zap trash: [
    "~/.lucent",
    "~/Library/Application Support/lucent",
  ]
end
