{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucent",
  "version": "0.1.0",
  "identifier": "com.lucent.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:sidecars && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lucent",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "LucentDB",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/lucent-driver-postgres",
      "binaries/lucent-driver-duckdb",
      "binaries/lucent-db-tools-mcp"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGMDFFRkFCQ0M1MjY0MDAKUldRQVpGTE1xKzhCLzlJZHFJa09FQkJ3RU8zTytpbUloM1FTN3BtUW1udmdZN2F5ejhPSnZ0eWoK",
      "endpoints": [
        "https://github.com/LucentDB/lucent/releases/latest/download/latest.json"
      ]
    }
  }
}
